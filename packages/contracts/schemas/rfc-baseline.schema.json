{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/rfc-baseline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRevision", "algorithm", "selection", "rfcs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "algorithm": { "const": "sha256-utf8-bytes" },
    "selection": { "const": "all-numbered-rfcs" },
    "rfcs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^docs/rfcs/[0-9]{4}-[a-z0-9-]+\\.md$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
