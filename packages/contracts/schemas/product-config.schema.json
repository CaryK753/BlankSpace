{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/product-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "targets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "preset": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "product": { "$ref": "shared.schema.json#/$defs/relativePath" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["web", "server"] }
    },
    "kits": {
      "type": "object",
      "propertyNames": { "$ref": "shared.schema.json#/$defs/packageId" },
      "additionalProperties": { "type": "object" }
    },
    "serviceProviders": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9.-]+$" },
      "additionalProperties": { "$ref": "shared.schema.json#/$defs/packageId" }
    },
    "enabledFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$" }
    }
  }
}
