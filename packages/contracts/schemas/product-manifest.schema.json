{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/product-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": { "$ref": "shared.schema.json#/$defs/relativePath" },
        "server": { "$ref": "shared.schema.json#/$defs/relativePath" }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "shared.schema.json#/$defs/relativePath" }
    }
  }
}
