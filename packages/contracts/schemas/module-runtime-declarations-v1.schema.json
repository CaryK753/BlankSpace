{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/module-runtime-declarations-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "anyOf": [
    {
      "required": ["serviceProviders"],
      "properties": { "serviceProviders": true }
    },
    {
      "required": ["eventHandlers"],
      "properties": { "eventHandlers": true }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "serviceProviders": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/serviceProvider" }
    },
    "eventHandlers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/eventHandler" }
    }
  },
  "$defs": {
    "serviceProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceId", "contractVersion", "providerId", "entry"],
      "properties": {
        "serviceId": { "$ref": "#/$defs/runtimeId" },
        "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "providerId": { "$ref": "#/$defs/runtimeId" },
        "entry": { "$ref": "#/$defs/runtimeEntry" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/runtimeId" }
        }
      }
    },
    "eventHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "versionRange", "handlerId", "entry"],
      "properties": {
        "eventId": { "$ref": "#/$defs/runtimeId" },
        "versionRange": { "type": "string", "pattern": "^(?:\\^)?[0-9]+(?:\\.[0-9]+){0,2}$" },
        "handlerId": { "$ref": "#/$defs/runtimeId" },
        "entry": { "$ref": "#/$defs/runtimeEntry" }
      }
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*[a-z0-9]$"
    },
    "runtimeEntry": { "enum": ["web", "server"] }
  }
}
