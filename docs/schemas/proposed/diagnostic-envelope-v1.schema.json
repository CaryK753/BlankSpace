{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/proposed/diagnostic-envelope-v1.schema.json",
  "title": "DiagnosticEnvelopeV1 (Proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "context", "status", "diagnostics", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "command": { "type": "string", "minLength": 1 },
    "context": { "type": "object", "additionalProperties": false, "required": ["projectRoot", "graphHash", "lockHash"], "properties": { "projectRoot": { "const": "." }, "graphHash": { "$ref": "#/$defs/nullableHash" }, "lockHash": { "$ref": "#/$defs/nullableHash" } } },
    "status": { "enum": ["succeeded", "failed", "blocked"] },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "relativePath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "operation": { "type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "status": { "enum": ["succeeded", "failed", "blocked", "skipped"] }, "artifactHashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } } } },
    "location": { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "$ref": "#/$defs/relativePath" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } } },
    "change": { "type": "object", "additionalProperties": false, "required": ["path", "beforeHash", "patchHash"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "beforeHash": { "$ref": "#/$defs/hash" }, "patchHash": { "$ref": "#/$defs/hash" } } },
    "fix": { "type": "object", "additionalProperties": false, "required": ["kind", "safe"], "properties": { "kind": { "type": "string" }, "safe": { "type": "boolean" }, "changeSet": { "type": "array", "items": { "$ref": "#/$defs/change" } } } },
    "diagnostic": { "type": "object", "additionalProperties": false, "required": ["code", "severity", "category", "message", "related"], "properties": { "code": { "type": "string", "pattern": "^BS[1-7][0-9]{3}$" }, "severity": { "enum": ["error", "warning", "info"] }, "category": { "type": "string" }, "message": { "type": "string" }, "location": { "$ref": "#/$defs/location" }, "related": { "type": "array", "items": { "$ref": "#/$defs/location" } }, "help": { "type": "string" }, "fix": { "$ref": "#/$defs/fix" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "hash", "role"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "hash": { "$ref": "#/$defs/hash" }, "role": { "type": "string" } } }
  }
}
