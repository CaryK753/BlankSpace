{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/proposed/sync-protocol-v1.schema.json",
  "title": "SyncProtocolV1 (Proposed)",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/negotiated" },
    { "$ref": "#/$defs/incompatible" },
    { "$ref": "#/$defs/batch" },
    { "$ref": "#/$defs/batchResult" },
    { "$ref": "#/$defs/blobChunk" },
    { "$ref": "#/$defs/blobTransfer" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "range": { "type": "string", "pattern": "^\\^[0-9]+(?:\\.[0-9]+){0,2}$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workspaceRef": { "type": "object", "additionalProperties": false, "required": ["sourceId", "workspaceId"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "workspaceId": { "type": "string", "minLength": 1 } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["id", "hash", "protocolVersion"], "properties": { "id": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" }, "protocolVersion": { "$ref": "#/$defs/version" } } },
    "hello": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "protocolId", "supportedVersions", "clientInstanceId", "workspace", "dataDomain", "capabilities"], "properties": { "kind": { "const": "sync-hello" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "protocolId": { "$ref": "#/$defs/id" }, "supportedVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/range" } }, "clientInstanceId": { "type": "string", "minLength": 1 }, "workspace": { "$ref": "#/$defs/workspaceRef" }, "dataDomain": { "$ref": "#/$defs/id" }, "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "negotiated": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "sessionId", "protocolVersion", "policyVersion", "permissionEpoch", "maxBatchOperations", "maxBatchBytes", "capabilities"], "properties": { "kind": { "const": "sync-negotiated" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 }, "protocolVersion": { "$ref": "#/$defs/version" }, "policyVersion": { "$ref": "#/$defs/version" }, "permissionEpoch": { "type": "integer", "minimum": 0 }, "maxBatchOperations": { "type": "integer", "minimum": 1 }, "maxBatchBytes": { "type": "integer", "minimum": 1 }, "checkpoint": { "$ref": "#/$defs/checkpoint" }, "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "incompatible": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "protocolId", "clientRanges", "serverRanges", "code", "recoveryChoices"], "properties": { "kind": { "const": "sync-incompatible" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "protocolId": { "$ref": "#/$defs/id" }, "clientRanges": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/range" } }, "serverRanges": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/range" } }, "code": { "const": "SYNC_PROTOCOL_INCOMPATIBLE" }, "recoveryChoices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["read-only", "retry-later", "upgrade-client"] } } } },
    "blobRef": { "type": "object", "additionalProperties": false, "required": ["contentHash", "size", "mediaType"], "properties": { "contentHash": { "$ref": "#/$defs/hash" }, "size": { "type": "integer", "minimum": 0 }, "mediaType": { "type": "string", "minLength": 1 } } },
    "operation": { "type": "object", "additionalProperties": false, "required": ["operationId", "workspace", "dataDomain", "resourceId", "protocolVersion", "formatId", "formatVersion", "authorPrincipal", "clientSequence", "permissionEpoch", "operationKind", "payloadEncoding", "payloadHash", "payloadBytes", "payloadBase64", "blobRefs", "causalOperationIds"], "properties": { "operationId": { "type": "string", "minLength": 1 }, "workspace": { "$ref": "#/$defs/workspaceRef" }, "dataDomain": { "$ref": "#/$defs/id" }, "resourceId": { "type": "string", "minLength": 1 }, "protocolVersion": { "$ref": "#/$defs/version" }, "formatId": { "$ref": "#/$defs/id" }, "formatVersion": { "$ref": "#/$defs/version" }, "authorPrincipal": { "type": "string", "minLength": 1 }, "clientSequence": { "type": "integer", "minimum": 1 }, "permissionEpoch": { "type": "integer", "minimum": 0 }, "baseCheckpoint": { "$ref": "#/$defs/checkpoint" }, "operationKind": { "enum": ["change", "delete", "restore"] }, "payloadEncoding": { "enum": ["canonical-json", "base64"] }, "payloadHash": { "$ref": "#/$defs/hash" }, "payloadBytes": { "type": "integer", "minimum": 0 }, "payloadBase64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }, "blobRefs": { "type": "array", "items": { "$ref": "#/$defs/blobRef" } }, "causalOperationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "batch": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "batchId", "sessionId", "firstSequence", "lastSequence", "operations"], "properties": { "kind": { "const": "sync-change-batch" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "batchId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 }, "baseCheckpoint": { "$ref": "#/$defs/checkpoint" }, "firstSequence": { "type": "integer", "minimum": 1 }, "lastSequence": { "type": "integer", "minimum": 1 }, "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } } } },
    "domainConflict": { "type": "object", "additionalProperties": false, "required": ["outcome", "evidenceHash"], "properties": { "outcome": { "enum": ["merged", "needs-user-action", "server-rejected", "policy-redacted"] }, "evidenceHash": { "$ref": "#/$defs/hash" } } },
    "snapshotRebase": { "type": "object", "additionalProperties": false, "required": ["reasonCode", "targetFormatId", "targetFormatVersion", "unacknowledgedPolicy"], "properties": { "reasonCode": { "type": "string", "pattern": "^SYNC_[A-Z0-9_]+$" }, "targetFormatId": { "$ref": "#/$defs/id" }, "targetFormatVersion": { "$ref": "#/$defs/version" }, "unacknowledgedPolicy": { "enum": ["preserve-and-reapply", "preserve-in-quarantine"] } } },
    "quarantine": { "type": "object", "additionalProperties": false, "required": ["exportScopes", "redactionPolicyId", "evidenceHash"], "properties": { "exportScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "redactionPolicyId": { "$ref": "#/$defs/id" }, "evidenceHash": { "$ref": "#/$defs/hash" } } },
    "operationResult": { "type": "object", "additionalProperties": false, "required": ["operationId", "status", "code"], "properties": { "operationId": { "type": "string", "minLength": 1 }, "status": { "enum": ["applied", "duplicate", "deferred", "rejected", "quarantined"] }, "code": { "type": "string", "pattern": "^SYNC_[A-Z0-9_]+$" }, "evidenceHash": { "$ref": "#/$defs/hash" }, "domainConflict": { "$ref": "#/$defs/domainConflict" }, "snapshotRebase": { "$ref": "#/$defs/snapshotRebase" }, "quarantine": { "$ref": "#/$defs/quarantine" }, "recoveryChoices": { "type": "array", "uniqueItems": true, "items": { "enum": ["retry", "snapshot-rebase", "export-quarantine", "request-access", "read-only"] } } }, "allOf": [{ "if": { "properties": { "status": { "const": "quarantined" } }, "required": ["status"] }, "then": { "properties": { "quarantine": { "$ref": "#/$defs/quarantine" } }, "required": ["quarantine"] } }, { "if": { "properties": { "recoveryChoices": { "type": "array", "contains": { "const": "snapshot-rebase" } } }, "required": ["recoveryChoices"] }, "then": { "properties": { "snapshotRebase": { "$ref": "#/$defs/snapshotRebase" } }, "required": ["snapshotRebase"] } }, { "if": { "properties": { "code": { "const": "SYNC_PERMISSION_REVOKED" } }, "required": ["code"] }, "then": { "properties": { "status": { "enum": ["rejected", "quarantined"] }, "quarantine": { "$ref": "#/$defs/quarantine" }, "recoveryChoices": { "type": "array", "contains": { "const": "export-quarantine" } } }, "required": ["quarantine", "recoveryChoices"] } }] },
    "batchResult": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "batchId", "results", "checkpoint"], "properties": { "kind": { "const": "sync-batch-result" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "batchId": { "type": "string", "minLength": 1 }, "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationResult" } }, "checkpoint": { "$ref": "#/$defs/checkpoint" } } },
    "blobChunk": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "contentHash", "chunkIndex", "chunkCount", "chunkHash", "chunkBytes", "payloadBase64", "resumeToken"], "properties": { "kind": { "const": "sync-blob-chunk" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "contentHash": { "$ref": "#/$defs/hash" }, "chunkIndex": { "type": "integer", "minimum": 0 }, "chunkCount": { "type": "integer", "minimum": 1 }, "chunkHash": { "$ref": "#/$defs/hash" }, "chunkBytes": { "type": "integer", "minimum": 1 }, "payloadBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }, "resumeToken": { "type": "string", "minLength": 1 } } },
    "blobTransferChunk": { "type": "object", "additionalProperties": false, "required": ["chunkIndex", "chunkHash", "chunkBytes", "payloadBase64"], "properties": { "chunkIndex": { "type": "integer", "minimum": 0 }, "chunkHash": { "$ref": "#/$defs/hash" }, "chunkBytes": { "type": "integer", "minimum": 1 }, "payloadBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" } } },
    "blobTransfer": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "correlationId", "contentHash", "totalBytes", "chunks"], "properties": { "kind": { "const": "sync-blob-transfer" }, "schemaVersion": { "const": "1" }, "correlationId": { "type": "string", "minLength": 1 }, "contentHash": { "$ref": "#/$defs/hash" }, "totalBytes": { "type": "integer", "minimum": 1 }, "chunks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blobTransferChunk" } } } }
  },
  "x-semanticConstraints": [
    "operation identity is workspace plus dataDomain plus operationId and cannot map to multiple payload hashes",
    "batch sequences and operation clientSequence values are contiguous and ordered",
    "ack checkpoint advances only after every operation result is durably recorded",
    "rejected or quarantined operations are never retried without an explicit recovery choice",
    "payload and blob hashes cover decoded bytes",
    "chunkBytes equals decoded payloadBase64 length",
    "blob transfer chunks are contiguous from zero and concatenate to totalBytes and contentHash",
    "quarantined results include export scope, redaction policy and evidence",
    "snapshot-rebase recovery includes target format and unacknowledged operation policy"
  ]
}
