{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/proposed/editor-engine-v1.schema.json",
  "title": "EditorEngineBoundaryV1 (Proposed)",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/documentRef" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/operationRequest" },
    { "$ref": "#/$defs/operationResult" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workspaceRef": { "type": "object", "additionalProperties": false, "required": ["sourceId", "workspaceId"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "workspaceId": { "type": "string", "minLength": 1 } } },
    "documentRef": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "workspace", "documentId", "engineId", "formatId", "formatVersion"], "properties": { "kind": { "const": "editor-document-ref" }, "schemaVersion": { "const": "1" }, "workspace": { "$ref": "#/$defs/workspaceRef" }, "documentId": { "type": "string", "minLength": 1 }, "engineId": { "$ref": "#/$defs/id" }, "formatId": { "$ref": "#/$defs/id" }, "formatVersion": { "$ref": "#/$defs/version" } } },
    "command": { "type": "object", "additionalProperties": false, "required": ["id", "parameterSchemaHash", "resultSchemaHash", "availabilitySchemaHash"], "properties": { "id": { "$ref": "#/$defs/id" }, "parameterSchemaHash": { "$ref": "#/$defs/hash" }, "resultSchemaHash": { "$ref": "#/$defs/hash" }, "availabilitySchemaHash": { "$ref": "#/$defs/hash" } } },
    "contentKind": { "type": "object", "additionalProperties": false, "required": ["id", "schemaVersion", "renderContractHash", "indexProjectionSchemaHash"], "properties": { "id": { "$ref": "#/$defs/id" }, "schemaVersion": { "$ref": "#/$defs/version" }, "renderContractHash": { "$ref": "#/$defs/hash" }, "indexProjectionSchemaHash": { "$ref": "#/$defs/hash" } } },
    "extension": { "type": "object", "additionalProperties": false, "required": ["id", "version", "requiredExtensions", "contentKinds", "commands", "migrationIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "requiredExtensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "contentKinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentKind" } }, "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }, "migrationIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "operationDescriptor": { "type": "object", "additionalProperties": false, "required": ["name", "requestSchemaHash", "resultSchemaHash"], "properties": { "name": { "enum": ["create", "open", "close", "snapshot", "transaction", "observe", "import", "export", "index-project", "sync-encode"] }, "requestSchemaHash": { "$ref": "#/$defs/hash" }, "resultSchemaHash": { "$ref": "#/$defs/hash" } } },
    "manifest": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "engineId", "engineVersion", "publicApiSchemaHash", "operations", "formats", "extensions", "capabilities", "protocols"], "properties": { "kind": { "const": "editor-engine-manifest" }, "schemaVersion": { "const": "1" }, "engineId": { "$ref": "#/$defs/id" }, "engineVersion": { "$ref": "#/$defs/version" }, "publicApiSchemaHash": { "$ref": "#/$defs/hash" }, "operations": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/operationDescriptor" } }, "formats": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "version", "encoding", "maxBytes"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "encoding": { "enum": ["canonical-json", "binary"] }, "maxBytes": { "type": "integer", "minimum": 1 } } } }, "extensions": { "type": "array", "items": { "$ref": "#/$defs/extension" } }, "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["snapshot", "transaction", "import", "export", "index-projection", "sync-codec", "persistent-undo"] } }, "protocols": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" } } } } } },
    "blobChange": { "type": "object", "additionalProperties": false, "required": ["action", "contentHash"], "properties": { "action": { "enum": ["add", "remove"] }, "contentHash": { "$ref": "#/$defs/hash" } } },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "document", "transactionId", "baseRevision", "resultRevision", "recordHashes", "blobChanges", "syncOperationIds", "indexInvalidations"], "properties": { "kind": { "const": "editor-transaction-receipt" }, "schemaVersion": { "const": "1" }, "document": { "$ref": "#/$defs/documentRef" }, "transactionId": { "type": "string", "minLength": 1 }, "baseRevision": { "type": "integer", "minimum": 0 }, "resultRevision": { "type": "integer", "minimum": 1 }, "recordHashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } }, "blobChanges": { "type": "array", "items": { "$ref": "#/$defs/blobChange" } }, "syncOperationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "indexInvalidations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "operationRequest": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "requestId", "engineId", "operation", "requestSchemaHash", "payloadHash"], "properties": { "kind": { "const": "editor-operation-request" }, "schemaVersion": { "const": "1" }, "requestId": { "type": "string", "minLength": 1 }, "engineId": { "$ref": "#/$defs/id" }, "operation": { "$ref": "#/$defs/operationDescriptor/properties/name" }, "document": { "$ref": "#/$defs/documentRef" }, "requestSchemaHash": { "$ref": "#/$defs/hash" }, "payloadHash": { "$ref": "#/$defs/hash" } } },
    "operationResult": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "requestId", "status", "resultSchemaHash", "diagnosticCodes"], "properties": { "kind": { "const": "editor-operation-result" }, "schemaVersion": { "const": "1" }, "requestId": { "type": "string", "minLength": 1 }, "status": { "enum": ["succeeded", "failed", "blocked", "read-only"] }, "resultSchemaHash": { "$ref": "#/$defs/hash" }, "payloadHash": { "$ref": "#/$defs/hash" }, "diagnosticCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EDITOR_[A-Z0-9_]+$" } } } }
  },
  "x-semanticConstraints": [
    "resultRevision is greater than baseRevision",
    "extension dependency graph is acyclic and identities are unique",
    "document storage records, blob reference changes and sync outbox commit atomically",
    "all hashes cover canonical bytes declared by the selected format"
    ,"manifest operations include create, open, close, snapshot, transaction, observe, import, export and index-project exactly once"
  ]
}
