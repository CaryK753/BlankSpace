{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/proposed/upgrade-contracts-v2.schema.json",
  "title": "Client Upgrade Contracts V2 (Proposed)",
  "oneOf": [{ "$ref": "#/$defs/lock" }, { "$ref": "#/$defs/compatibility" }, { "$ref": "#/$defs/plan" }],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "versionRange": { "type": "object", "additionalProperties": false, "required": ["minInclusive", "maxExclusive"], "properties": { "minInclusive": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "maxExclusive": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["id", "logicalReleaseId", "distributionManifestHash", "role", "ecosystem", "coordinate", "version", "sourceRevision", "contentHash", "contractHash", "provenanceHash"], "properties": { "id": { "type": "string" }, "logicalReleaseId": { "type": "string" }, "distributionManifestHash": { "$ref": "#/$defs/hash" }, "role": { "type": "string" }, "ecosystem": { "type": "string" }, "coordinate": { "type": "string" }, "version": { "type": "string" }, "sourceRevision": { "type": "string" }, "contentHash": { "$ref": "#/$defs/hash" }, "contractHash": { "$ref": "#/$defs/hash" }, "provenanceHash": { "$ref": "#/$defs/hash" } } },
    "distributionLock": { "type": "object", "additionalProperties": false, "required": ["logicalReleaseId", "contentHash"], "properties": { "logicalReleaseId": { "type": "string" }, "contentHash": { "$ref": "#/$defs/hash" } } },
    "clientLock": { "type": "object", "additionalProperties": false, "required": ["clientId", "runtimeManifestHash", "distributionManifests", "artifacts", "generated"], "properties": { "clientId": { "type": "string" }, "runtimeManifestHash": { "$ref": "#/$defs/hash" }, "distributionManifests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/distributionLock" } }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "generated": { "type": "array", "items": { "$ref": "#/$defs/hash" } } } },
    "logicalRelease": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contractHash"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "contractHash": { "$ref": "#/$defs/hash" } } },
    "lock": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "logicalReleases", "clients"], "properties": { "kind": { "const": "lock" }, "schemaVersion": { "const": "2" }, "logicalReleases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/logicalRelease" } }, "clients": { "type": "array", "items": { "$ref": "#/$defs/clientLock" } } } },
    "clientCompatibility": { "type": "object", "additionalProperties": false, "required": ["selector", "runtimeRange", "contractRanges", "designSystemRange", "toolchains", "evidencePolicy"], "properties": { "selector": { "type": "object", "additionalProperties": false, "required": ["platform"], "properties": { "platform": { "type": "string" }, "runtimeId": { "type": "string" }, "uiFamilyId": { "type": "string" } } }, "runtimeRange": { "$ref": "#/$defs/versionRange" }, "contractRanges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/versionRange" } }, "designSystemRange": { "$ref": "#/$defs/versionRange" }, "toolchains": { "type": "object", "additionalProperties": { "$ref": "#/$defs/versionRange" } }, "evidencePolicy": { "type": "string" } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "release", "clients"], "properties": { "kind": { "const": "compatibility" }, "schemaVersion": { "const": "2" }, "release": { "type": "string" }, "clients": { "type": "array", "items": { "$ref": "#/$defs/clientCompatibility" } } } },
    "nullableHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "change": { "type": "object", "additionalProperties": false, "required": ["id", "clientId", "operation", "kind", "target", "risk", "beforeHash", "afterHash"], "properties": { "id": { "type": "string" }, "clientId": { "type": "string" }, "operation": { "enum": ["add", "remove", "update"] }, "kind": { "enum": ["artifact", "generator", "renderer", "theme", "evidence", "package-lock", "generated"] }, "target": { "type": "object", "additionalProperties": false, "required": ["id", "ecosystem", "path"], "properties": { "id": { "type": "string" }, "ecosystem": { "enum": ["npm", "swiftpm", "maven", "binary", "blankspace"] }, "path": { "type": "string" } } }, "risk": { "enum": ["low", "medium", "high", "blocked"] }, "beforeHash": { "$ref": "#/$defs/nullableHash" }, "afterHash": { "$ref": "#/$defs/nullableHash" } } },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["clientId", "graphHash", "resultHash", "status"], "properties": { "clientId": { "type": "string" }, "graphHash": { "$ref": "#/$defs/hash" }, "resultHash": { "$ref": "#/$defs/hash" }, "status": { "const": "passed" } } },
    "plan": { "type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion", "fromLockHash", "toRelease", "changes", "stagingRoot", "verifyReceipts", "commitMode", "recovery"], "properties": { "kind": { "const": "upgrade-plan" }, "schemaVersion": { "const": "2" }, "fromLockHash": { "$ref": "#/$defs/hash" }, "toRelease": { "type": "string" }, "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }, "stagingRoot": { "type": "string", "pattern": "^\\.blankspace/staging/[a-zA-Z0-9._-]+$" }, "verifyReceipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receipt" } }, "commitMode": { "const": "atomic-after-verify" }, "recovery": { "enum": ["restore-pre-migration", "rfc-0010-post-migration"] } } }
  },
  "x-semanticConstraints": ["client IDs and artifact IDs are unique", "all target-client changes verify before commit", "runtime family migration is blocked and requires a separate migration project"]
}
