{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/proposed/support-evidence-v1.schema.json",
  "title": "SupportEvidenceV1 (Proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "serial", "subject", "suite", "toolchains", "results", "issuer", "issuedAt", "expiresAt", "signature"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "serial": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalId", "logicalVersion", "artifactHash", "contractHash"],
      "properties": {
        "logicalId": { "type": "string" }, "logicalVersion": { "type": "string" },
        "artifactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "toolchains": { "type": "object", "additionalProperties": { "type": "string" } },
    "results": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["fixture", "status"], "properties": { "fixture": { "type": "string" }, "status": { "enum": ["passed", "failed", "blocked"] } } } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "issuer": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "payloadHash", "value"],
      "properties": { "algorithm": { "enum": ["ed25519"] }, "keyId": { "type": "string" }, "payloadHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "value": { "type": "string" } }
    },
    "provenance": { "type": "string" }
  }
}
