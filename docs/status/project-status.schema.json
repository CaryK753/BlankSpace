{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/project-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "phase", "production", "nextWorkItem", "implemented", "unavailable", "spikes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "phase": { "const": "phase-1a-spike" },
    "production": { "const": "no-go" },
    "nextWorkItem": { "type": "string", "pattern": "^A1-[A-Z0-9]+-[0-9]{2}$" },
    "implemented": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "unavailable": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "spikes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "cr1", "ds1", "sc1", "n1", "e1", "y1"],
      "properties": {
        "s1": { "$ref": "#/$defs/spike" }, "s2": { "$ref": "#/$defs/spike" },
        "s3": { "$ref": "#/$defs/spike" }, "s4": { "$ref": "#/$defs/spike" },
        "s5": { "$ref": "#/$defs/spike" }, "s6": { "$ref": "#/$defs/spike" },
        "s7": { "$ref": "#/$defs/spike" }, "s8": { "$ref": "#/$defs/spike" },
        "cr1": { "$ref": "#/$defs/spike" }, "ds1": { "$ref": "#/$defs/spike" },
        "sc1": { "$ref": "#/$defs/spike" }, "n1": { "$ref": "#/$defs/spike" },
        "e1": { "$ref": "#/$defs/spike" }, "y1": { "$ref": "#/$defs/spike" }
      }
    }
  },
  "$defs": {
    "spike": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence", "nextGate"],
      "properties": {
        "status": { "enum": ["not-started", "draft-matrix", "matrix-frozen", "provisional-pass", "pass", "failed"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "nextGate": { "type": "string", "minLength": 1 }
      }
    }
  }
}
