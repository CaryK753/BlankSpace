{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/spikes/s4-registry-transcript-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "matrix", "assemblyId", "registryHash", "entryIds", "bindings", "handlers", "factoryExecutions", "mismatches"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingDirectoryCount", "inputOrderCount"],
      "properties": {
        "workingDirectoryCount": { "const": 2 },
        "inputOrderCount": { "const": 2 }
      }
    },
    "assemblyId": { "$ref": "#/$defs/digest" },
    "registryHash": { "$ref": "#/$defs/digest" },
    "entryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "bindings": { "const": 0 },
    "handlers": { "const": 0 },
    "factoryExecutions": { "const": 0 },
    "mismatches": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
