{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/spikes/s3-bundle-artifact-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "sourceIdentity", "fileName", "target", "contentHash"],
  "properties": {
    "kind": { "enum": ["css", "worker", "wasm", "asset", "virtual-module"] },
    "sourceIdentity": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\).+$" },
    "fileName": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\).+$" },
    "target": { "const": "web" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
