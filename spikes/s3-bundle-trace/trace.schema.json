{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/spikes/s3-bundle-trace-v1.schema.json",
  "title": "Blankspace S3 Bundle Trace V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "tools", "matrix", "traceHash", "fixtures", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "vite"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "vite": { "type": "string", "minLength": 1 }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkoutCount", "pnpmStoreCount"],
      "properties": {
        "checkoutCount": { "type": "integer", "minimum": 2 },
        "pnpmStoreCount": { "type": "integer", "minimum": 2 }
      }
    },
    "traceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fixtures": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expected": { "enum": ["pass", "compiler-reject"] },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "importKind", "sourceEdge", "bundleModules"],
                "properties": {
                  "status": { "const": "pass" },
                  "importKind": { "enum": ["static", "dynamic-static"] },
                  "sourceEdge": { "$ref": "https://blankspace.dev/schemas/resolution-record-v1.schema.json" },
                  "bundleModules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["chunk", "logicalPath", "target", "contentHash"],
                      "properties": {
                        "chunk": { "type": "string", "minLength": 1 },
                        "logicalPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
                        "packageIdentity": { "type": "string", "minLength": 1 },
                        "target": { "enum": ["web", "server"] },
                        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "code", "path"],
                "properties": {
                  "status": { "const": "compiler-reject" },
                  "code": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "https://blankspace.dev/schemas/spikes/s3-bundle-artifact-v1.schema.json" }
    }
  }
}
