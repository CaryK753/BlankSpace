{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blankspace.dev/schemas/spikes/s6-server-signal-transcript-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "support", "signals"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["platform", "arch", "node"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "pattern": "^v24\\." }
      }
    },
    "support": { "enum": ["posix", "unsupported-by-node"] },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "handlerInvocationCount", "outcome", "state", "readyCount", "listenCount", "serverCloseCount", "stopInvocationCount", "entryStopCounts", "diagnostics", "trace", "activeRequestCount", "pendingOwners", "resourceBalance", "exitClassification"],
        "properties": {
          "signal": { "enum": ["SIGTERM", "SIGINT"] },
          "handlerInvocationCount": { "const": 2 },
          "outcome": { "const": "stopped" },
          "state": { "const": "stopped" },
          "readyCount": { "const": 1 },
          "listenCount": { "const": 1 },
          "serverCloseCount": { "const": 1 },
          "stopInvocationCount": { "const": 2 },
          "entryStopCounts": { "type": "object" },
          "diagnostics": { "type": "array" },
          "trace": { "type": "array", "items": { "type": "string" } },
          "activeRequestCount": { "const": 0 },
          "pendingOwners": { "type": "array", "maxItems": 0 },
          "resourceBalance": { "const": 0 },
          "exitClassification": { "const": "zero" }
        }
      }
    }
  }
}
